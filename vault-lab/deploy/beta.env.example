# Copy public Privy configuration and the dedicated inference key privately.
# Never include a management key in a deployed environment.
OPENROUTER_API_KEY=
PRIVY_APP_ID=
PRIVY_CLIENT_ID=
PRIVY_VERIFICATION_KEY=
VAULT_ACCESS_MODE=public-practice
VAULT_CLOSED_BETA=true
VAULT_PUBLIC_ORIGIN=https://REPLACE_WITH_APPROVED_HOST
VAULT_BIND_ADDRESS=127.0.0.1
PORT=4319
VAULT_API_BUDGET_USD=5
VAULT_REQUESTS_PER_USER_DAY=25
VAULT_REQUESTS_PER_DAY=250
VAULT_TELEGRAM_ENABLED=false

# x402 operating box (Base USDC). Create a NEW VPS wallet. Do not upload the laptop
# rehearsal key 0xf282…0c8f, treasury 0xbec4…396d, or deposit payer 0x686c…2f79.
# Fund the new address with ~2–3 USDC plus Base ETH for gas, then set:
# VAULT_X402_PRIVATE_KEY=0x...
# VAULT_X402_FLOOR_USDC=1
# VAULT_X402_RPC_URL=https://mainnet.base.org
VAULT_X402_PRIVATE_KEY=
VAULT_X402_FLOOR_USDC=1
VAULT_X402_RPC_URL=https://mainnet.base.org
