# Template only. Create a dedicated vault user and review paths before installation.
[Unit]
Description=Vault authenticated practice
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vault
Group=vault
WorkingDirectory=/opt/vault
ExecStart=/usr/bin/env node --env-file=.env server.mjs
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/vault/.local

[Install]
WantedBy=multi-user.target
