{
  "name": "dear-vault-local-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "package:release": "node scripts/package-release.mjs",
    "drill:restore": "node audit/restore-drill.mjs",
    "drill:concurrency": "node audit/concurrency-drill.mjs",
    "drill:deposits": "node audit/deposit-drill.mjs",
    "drill:monitor": "node audit/deposit-monitor-drill.mjs",
    "drill:funding": "node audit/prize-funding-drill.mjs",
    "drill:accounts": "node audit/account-game-drill.mjs",
    "audit:asset": "node audit/verify-asset-ledger.mjs",
    "audit:public-readiness": "node audit/public-launch-readiness.mjs",
    "drill:public-traffic": "node audit/public-traffic-drill.mjs",
    "preflight": "node --env-file-if-exists=.env scripts/preflight.mjs",
    "start": "node --env-file-if-exists=.env server.mjs",
    "paid-beta:testnet": "node --env-file-if-exists=.env scripts/paid-beta-testnet.mjs",
    "paid-beta:testnet-deposit": "node --env-file-if-exists=.env scripts/paid-beta-testnet-deposit.mjs",
    "paid-beta:turso": "node scripts/paid-beta-turso.mjs",
    "paid-beta:vercel-preflight": "node --env-file-if-exists=.env scripts/paid-beta-vercel-preflight.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@privy-io/js-sdk-core": "0.75.0",
    "@privy-io/node": "0.34.0",
    "viem": "2.56.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
