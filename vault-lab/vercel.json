{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "fluid": true,
  "buildCommand": "node scripts/build-vercel.mjs",
  "installCommand": "npm ci --ignore-scripts",
  "outputDirectory": ".vercel-static",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": "{server/**,config/**,public/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__vault_path=/api/:path*" },
    { "source": "/", "has": [{ "type": "query", "key": "ui" }], "destination": "/chat.html" },
    { "source": "/", "destination": "/landing.html" },
    { "source": "/play", "destination": "/chat.html" },
    { "source": "/play/", "destination": "/chat.html" },
    { "source": "/fairness", "destination": "/fairness.html" },
    { "source": "/fairness/", "destination": "/fairness.html" },
    { "source": "/sign-deposit", "destination": "/sign-deposit.html" },
    { "source": "/sign-deposit/", "destination": "/sign-deposit.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
      { "key": "Cache-Control", "value": "no-store" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://auth.privy.io https://rpc.testnet.chain.robinhood.com; frame-src https://auth.privy.io; font-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" }
    ]},
    { "source": "/api/:path*", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
