# No launch credentials are used. LIVE_EXECUTION_ENABLED=true is rejected.
LIVE_EXECUTION_ENABLED=false
BELLFLY_PORT=8787
# Optional private control token, 32+ characters; otherwise local HTTP control is disabled.
# Never use a VITE_ prefix for secrets. CLI demo needs no token.
BELLFLY_CONTROL_TOKEN=
# Optional absolute path to Python in the project's virtual environment.
BELLFLY_PYTHON=
